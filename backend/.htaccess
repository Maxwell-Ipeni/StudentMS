# Enable Rewrite Engine
RewriteEngine On

# Set base directory
RewriteBase /StudentMS/backend/

# Handle CORS preflight
<IfModule mod_headers.c>
    # Dynamically set CORS origin based on request origin
    RewriteEngine On
    RewriteCond %{HTTP:Origin} ^http://localhost:3000$ [NC]
    RewriteRule .* - [E=CORS_ORIGIN:http://localhost:3000]
    
    RewriteCond %{HTTP:Origin} ^http://localhost:8080$ [NC]
    RewriteRule .* - [E=CORS_ORIGIN:http://localhost:8080]
    
    RewriteCond %{HTTP:Origin} ^https://your-domain\.com$ [NC]
    RewriteRule .* - [E=CORS_ORIGIN:https://your-domain.com]
    
    # Default to production domain if no match
    RewriteCond %{ENV:CORS_ORIGIN} ^$
    RewriteRule .* - [E=CORS_ORIGIN:https://your-domain.com]
    
    Header always set Access-Control-Allow-Origin "%{ENV:CORS_ORIGIN}e" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Access-Control-Allow-Headers, Authorization, X-Requested-With"
    Header always set Access-Control-Max-Age "3600"
    Header always set Access-Control-Allow-Credentials "true"

    # Security Headers
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Redirect all requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ api/index.php [QSA,L]

# Handle OPTIONS requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Deny access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect .env files
<FilesMatch "\.env$">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP settings
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300
php_value max_input_time 300